<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_quality" model="ir.ui.view">
        <field name="name">product.template.form.inherit.quality</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
            </xpath>
            <xpath expr="//page[@name='purchase']//group[@name='purchase']" position="inside">
                <group string="Controlo de Qualidade">
                    <field name="is_critical_for_supplier" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
