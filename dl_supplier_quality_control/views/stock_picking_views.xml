<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_quality" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.quality</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Adiciona a coluna Diferença na lista de operações (linhas do produto) -->
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='quantity']" position="after">
                <field name="qty_difference" readonly="1" decoration-danger="qty_difference &lt; 0" decoration-success="qty_difference == 0"/>
            </xpath>
        </field>
    </record>
</odoo>